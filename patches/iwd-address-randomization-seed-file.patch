+static bool wiphy_load_address_randomization_seed(const char *path)
+{
+	uint8_t seed[ADDRESS_RANDOMIZATION_SEED_LEN + 1];
+	struct stat st;
+	size_t offset = 0;
+	ssize_t bytes;
+	int fd;
+
+	fd = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+	if (fd < 0)
+		goto error;
+
+	if (fstat(fd, &st) < 0 || !S_ISREG(st.st_mode) || st.st_uid != 0 ||
+			(st.st_mode & (S_IRWXG | S_IRWXO)) ||
+			st.st_size != ADDRESS_RANDOMIZATION_SEED_LEN)
+		goto close_error;
+
+	while (offset < sizeof(seed)) {
+		bytes = read(fd, seed + offset, sizeof(seed) - offset);
+		if (bytes < 0) {
+			if (errno == EINTR)
+				continue;
+
+			goto close_error;
+		}
+
+		if (!bytes)
+			break;
+
+		offset += bytes;
+	}
+
+	close(fd);
+
+	if (offset != ADDRESS_RANDOMIZATION_SEED_LEN)
+		goto error;
+
+	memcpy(address_randomization_seed, seed,
+			sizeof(address_randomization_seed));
+	explicit_bzero(seed, sizeof(seed));
+	return true;
+
+close_error:
+	close(fd);
+error:
+	explicit_bzero(seed, sizeof(seed));
+	return false;
+}
