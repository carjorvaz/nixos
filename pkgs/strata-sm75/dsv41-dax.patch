+    // ---- the prefill's DAX window (STRATA_REGISTER_DAX)
+    // The pack's shards are mmap'd (Pack::map): on /optane, an fsdax XFS mount, their pages are device memory, and a
+    // DMA out of the mapping runs at 6.2-6.9 GB/s, where the flow's read path (O_DIRECT pread into pinned staging,
+    // then a copy) is ~1 GB/s.  The driver registers only ~7 GiB of host memory per process (8192 MiB fails with
+    // cudaErrorOutOfMemory; 6912 MiB is the documented-good single allocation) and one layer's experts are 2.65-3.33 GB,
+    // so the budget holds two layer windows: the layer being streamed and the one after it (double-buffered: the
+    // previous window is released only when a third must be registered, and only that release synchronizes the copy
+    // stream).  A window is the page-rounded span of a layer's matrix blocks that touch in one shard file - the GGUF
+    // holds w1, w3 and w2 of every expert of a layer side by side, so one window a layer on this pack; blocks in
+    // different files, or apart in one, get a window each.  Registered ReadOnly|Mapped|Portable, so flow_pump's
+    // cudaMemcpyAsync reads it at the DAX rate.  Rotated only from flow_spec (the prompt path's issue step), never in
+    // decode (40 layers a token there).
+    // A window's END is rounded in, not out: two layers' tensors share a page in the GGUF, and an outward rounding would
+    // overlap the next layer's window (the driver does not like overlapping registrations).  The one expert whose bytes
+    // cross that page then fails dax_covers and takes the ordinary read path - all-or-nothing per item: a partly
+    // registered gate / up / down would DMA from pageable memory (2.3 GB/s) or fault.
+    struct DaxWin {
+        int file = -1;
+        uint64_t off = 0, bytes = 0;   // [off, off + bytes) of that file's mapping, page-aligned
+        uint64_t last = 0;             // the rotation clock when a layer last needed it (evicted oldest first)
+        bool reg = false;
+    };
+    std::vector<DaxWin> dax_wins;
+    std::vector<std::vector<int>> dax_need;   // layer -> the windows its experts lie in
+    uint64_t dax_budget = 0, dax_used = 0, dax_clock = 0;
+    bool dax_ok = false, dax_short = false;   // (short: the budget holds one layer, said once)
+    int dax_live = -1;                        // the layer flow_spec last prepared: its items may still be in flight
+    int64_t dax_reg = 0, dax_rot = 0;         // registrations, and windows released to make room
+    static size_t dax_page() {
+#if defined(_WIN32)
+        return 4096;                          // (no DAX there: the window never opens)
+#else
+        static const size_t p = (size_t) sysconf(_SC_PAGESIZE);
+        return p;
+#endif
+    }
+    void dax_init() {
+        const char* on = std::getenv("DS4_REGISTER_DAX");
+        if (on == nullptr) on = std::getenv("STRATA_REGISTER_DAX");
+        if (on == nullptr || std::atoi(on) == 0) return;
+        const char* mib = std::getenv("DS4_REGISTER_DAX_MIB");
+        if (mib == nullptr) mib = std::getenv("STRATA_REGISTER_DAX_MIB");
+        dax_budget = (uint64_t) std::max(0, mib != nullptr ? std::atoi(mib) : 6912) << 20;
+        auto off = [](const char* why) { std::fprintf(stderr, "ds4: DAX window: off (%s)\n", why); };
+        if (!pk.gguf || !file_experts) return off("not a GGUF pack read in place");
+        if (L.empty() || devs.size() != 1 || L[0].nm != 1) return off("one GPU and tensor parallel 1 only");
+        if (chunks.empty() || chunks[0] == nullptr || !chunks[0]->flow) return off("the prompt path is not the flow");
+        if (const char* zc = std::getenv("DS4_STORE_ZC"); zc != nullptr && std::atoi(zc) != 0)
+            return off("DS4_STORE_ZC registers the store's arena from the same ~7 GiB");
+        if (dax_budget == 0) return off("a budget of 0 MiB");
+        const uint64_t pg = dax_page(), mask = pg - 1;
+        dax_need.assign(L.size(), std::vector<int>{});
+        double worst = 0;
+        for (const Layer& l : L) {
+            if (l.mtp || l.il >= g.nl || l.lay.fmt != gg::kFmtMXFP4) continue;   // (the trunk's GGUF experts only: not Engram, not the drafter)
+            struct Run {
+                uint64_t lo, hi;
+                int file;
+            } run[3];
+            int nr = 0;
+            for (int r = 0; r < 3; ++r) {   // the GGUF's [n_exp][out][in] block of this layer's gate / up / down
+                const int f = l.mx_file[r];
+                if (f < 0 || (size_t) f >= pk.maps.size() || pk.maps[(size_t) f].first == nullptr) continue;
+                const uint64_t hi = l.mx_off[r] + (uint64_t) (l.n_exp - 1) * l.mx_stride[r] + mx_part_bytes(l, r);
+                run[nr++] = Run{l.mx_off[r], hi, f};
+            }
+            std::sort(run, run + nr, [](const Run& a, const Run& b) { return a.file < b.file || (a.file == b.file && a.lo < b.lo); });
+            double bytes = 0;
+            for (int i = 0; i < nr; ++i) {   // (the blocks that touch - w1 then w3 then w2 in the file - are one window)
+                int j = i;
+                uint64_t end = run[i].hi;
+                while (j + 1 < nr && run[j + 1].file == run[i].file && run[j + 1].lo <= end)
+                    end = std::max(end, run[++j].hi);
+                const uint64_t a = run[i].lo & ~mask, b = end & ~mask;
+                if (b > a) {
+                    dax_wins.push_back(DaxWin{run[i].file, a, b - a});
+                    dax_need[(size_t) l.il].push_back((int) dax_wins.size() - 1);
+                    bytes += (double) (b - a);
+                }
+                i = j;
+            }
+            worst = std::max(worst, bytes);
+        }
+        if (dax_wins.empty()) return off("no layer's experts in the pack's mappings");
+        dax_ok = true;
+        std::fprintf(stderr,
+                     "ds4: DAX window: %llu MiB budget, %zu windows (page %llu B), the worst layer %.2f GB%s\n",
+                     (unsigned long long) (dax_budget >> 20), dax_wins.size(), (unsigned long long) pg, worst / 1e9,
+                     2.0 * worst <= (double) dax_budget ? " (two fit: double-buffered)"
+                                                         : " (two do NOT fit: every second layer direct)");
+    }
+    bool dax_covers(const uint8_t* p, size_t n) const {   // (page-aligned windows: containment, not overlap)
+        const uintptr_t a = (uintptr_t) p, e = a + n;
+        for (const DaxWin& w : dax_wins)
+            if (w.reg) {
+                const uintptr_t b = (uintptr_t) pk.maps[(size_t) w.file].first + w.off;
+                if (a >= b && e <= b + w.bytes) return true;
+            }
+        return false;
+    }
+    bool dax_covers_item(const Layer& l, int e) const {   // every byte of expert e's gate / up / down
+        if (!dax_ok || l.nm != 1) return false;
+        for (int r = 0; r < 3; ++r) {
+            const int f = l.mx_file[r];
+            if (f < 0 || (size_t) f >= pk.maps.size() || pk.maps[(size_t) f].first == nullptr) return false;
+            if (!dax_covers(pk.at(f, l.mx_off[r] + (uint64_t) e * l.mx_stride[r]), mx_part_bytes(l, r))) return false;
+        }
+        return true;
+    }
+    void dax_release(int i, cudaStream_t cs) {
+        DaxWin& w = dax_wins[(size_t) i];
+        if (!w.reg) return;
+        // the one synchronize: a copy already queued reads the window, and the driver does not defend a use-after-unmap
+        if (cs != nullptr && cudaStreamSynchronize(cs) != cudaSuccess) (void) cudaGetLastError();
+        if (cudaHostUnregister((void*) (pk.maps[(size_t) w.file].first + w.off)) != cudaSuccess) (void) cudaGetLastError();
+        dax_used -= w.bytes;
+        w.reg = false;
+        ++dax_rot;
+    }
+    bool dax_register(int i) {
+        DaxWin& w = dax_wins[(size_t) i];
+        cudaSetDevice(devs[0].id);
+        const cudaError_t e =
+            cudaHostRegister((void*) (pk.maps[(size_t) w.file].first + w.off), (size_t) w.bytes,
+                             cudaHostRegisterReadOnly | cudaHostRegisterMapped | cudaHostRegisterPortable);
+        if (e != cudaSuccess) {
+            (void) cudaGetLastError();   // (sticky: unconsumed, the next CK would report this failure in its name)
+            std::fprintf(stderr,
+                         "ds4: DAX window: registering %.2f GB of %s at +%.3f GB failed: %s - the prompt path reads from "
+                         "the files as before\n",
+                         (double) w.bytes / 1e9, pk.files[(size_t) w.file].c_str(), (double) w.off / 1e9,
+                         cudaGetErrorString(e));
+            dax_ok = false;
+            return false;
+        }
+        w.reg = true;
+        w.last = ++dax_clock;
+        dax_used += w.bytes;
+        ++dax_reg;
+        return true;
+    }
+    void dax_prepare(Chunk& c, int il) {   // the layer's window, before any of its items is pushed
+        if (!dax_ok || il < 0 || (size_t) il >= dax_need.size()) return;
+        const std::vector<int>& need = dax_need[(size_t) il];
+        if (need.empty()) return;
+        uint64_t missing = 0;
+        for (int i : need)
+            if (!dax_wins[(size_t) i].reg) missing += dax_wins[(size_t) i].bytes;
+        auto held = [&](size_t i) {
+            for (int j : need)
+                if ((size_t) j == i) return true;
+            if (dax_live >= 0 && (size_t) dax_live < dax_need.size())
+                for (int j : dax_need[(size_t) dax_live])   // (the live layer's copies may be queued but not run)
+                    if ((size_t) j == i) return true;
+            return false;
+        };
+        while (dax_used + missing > dax_budget) {
+            int victim = -1;
+            uint64_t oldest = UINT64_MAX;
+            for (size_t i = 0; i < dax_wins.size(); ++i) {
+                const DaxWin& w = dax_wins[i];
+                if (!w.reg || held(i) || w.last > oldest) continue;
+                oldest = w.last;
+                victim = (int) i;
+            }
+            if (victim < 0) {   // (the budget holds one layer only: this one reads from the files, the next rotates)
+                if (!dax_short) {
+                    dax_short = true;
+                    std::fprintf(stderr,
+                                 "ds4: DAX window: layer %d needs %.2f GB beside %.2f of %.2f GB still in flight - every "
+                                 "second layer reads from the files\n",
+                                 il, (double) missing / 1e9, (double) dax_used / 1e9, (double) dax_budget / 1e9);
+                }
+                dax_live = il;   // (its items are the ones in flight; the windows of the layer before it are done)
+                return;
+            }
+            dax_release(victim, c.cs);
+        }
+        for (int i : need) {
+            if (!dax_wins[(size_t) i].reg && !dax_register(i)) return;
+            dax_wins[(size_t) i].last = ++dax_clock;
+        }
+        dax_live = il;
+    }
+    void dax_close() {   // (~Impl, threads joined, Pack's mappings still there)
+        if (dax_wins.empty()) return;
+        for (size_t di = 0; di < chunks.size(); ++di)
+            if (chunks[di] != nullptr && chunks[di]->cs != nullptr) {
+                cudaSetDevice(devs[di].id);
+                if (cudaStreamSynchronize(chunks[di]->cs) != cudaSuccess) (void) cudaGetLastError();
+            }
+        size_t n = 0;
+        for (DaxWin& w : dax_wins)
+            if (w.reg) {
+                if (cudaHostUnregister((void*) (pk.maps[(size_t) w.file].first + w.off)) != cudaSuccess)
+                    (void) cudaGetLastError();   // (the unmap that follows is the last word anyway)
+                else ++n;
+                w.reg = false;
+            }
+        if (dax_reg > 0)
+            std::fprintf(stderr, "ds4: DAX window: %zu of %lld registrations out (%lld rotations), %.2f GB registered\n", n,
+                         (long long) dax_reg, (long long) dax_rot, (double) dax_used / 1e9);
+        dax_used = 0;
+        dax_ok = false;
+        dax_live = -1;
+    }
