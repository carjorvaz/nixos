+    if (off < w->off) return false;
+    const uint64_t rel = off - w->off;
+    if (rel > w->bytes || layer_blob_bytes_[(size_t) layer] > w->bytes - rel) return false;
+    window = w;
+    offset = rel;
+    return true;
+}
+
+// How far one registration can reach from `first`: the largest run of whole layers whose PAGE-ALIGNED span fits
+// the budget.  False when even `first` alone does not fit, i.e. a layer bigger than the whole budget - a layer
+// that can never be DMA-able, which is why `dma_ready` answers false for it and the prefill stages it as before.
+bool FileExpertSource::dax_fit(int64_t first, int64_t& last) const {
+    if (first < 0 || first >= n_layers_ || (size_t) first >= layer_blob_bytes_.size()) return false;
+    const uint64_t begin = page_down(layer_begin(first));
+    if (page_up(layer_end(first)) - begin > dax_budget_) return false;
+    int64_t b = first;
+    while (b + 1 < n_layers_ && page_up(layer_end(b + 1)) - begin <= dax_budget_) ++b;
+    last = b;
+    return true;
+}
+
+bool FileExpertSource::dax_register(int64_t first, int64_t last) {
+    const uint64_t off = page_down(layer_begin(first));
+    const uint64_t end = page_up(layer_end(last));
+    if (end <= off || end - off > dax_budget_) return false;
+    // ReadOnly: the engine only ever reads the pack through this alias, and the device must not write it.
+    // Mapped: the device needs an alias to read through.  Portable: the alias is valid in every context.
+    const cudaError_t reg = cudaHostRegister((void*) (base_ + off), (size_t) (end - off),
+                                             cudaHostRegisterReadOnly | cudaHostRegisterMapped |
+                                                 cudaHostRegisterPortable);
+    if (reg != cudaSuccess) {
+        std::fprintf(stderr,
+                     "FileExpertSource: STRATA_REGISTER_DAX: cudaHostRegister of layers %lld..%lld (%.2f GiB at "
+                     "offset %llu) failed: %s\n",
+                     (long long) first, (long long) last, (double) (end - off) / 1073741824.0,
+                     (unsigned long long) off, cudaGetErrorString(reg));
+        // **CONSUME THE ERROR, OR IT LIES ABOUT SOMETHING ELSE LATER** - the trap `PinnedArena` documents at
+        // length: until cudaGetLastError() reads it the failure is sticky, and the next reader is `gr_read`'s
+        // launch check, which would then report an out-of-memory for kernels that allocate nothing.  The failure
+        // is handled right here (the window stays where it was), so the state must not outlive that decision.
+        (void) cudaGetLastError();
+        return false;
+    }
+    void* alias = nullptr;
+    // `Mapped` only ASKS for the mapping: for a device that cannot do it the failure is deferred to this call
+    // (the runtime's own note on cudaHostRegisterMapped), so the alias is the real test.  A missing alias keeps
+    // the registration - the CPU reads it for free either way - and makes `device_alias()` report null for it.
+    const cudaError_t dev = cudaHostGetDevicePointer(&alias, (void*) (base_ + off), 0);
+    if (dev != cudaSuccess || alias == nullptr) {
+        (void) cudaGetLastError();
+        alias = nullptr;
+    }
+    DaxWindow w;
+    w.off = off;
+    w.bytes = end - off;
+    w.first = first;
+    w.last = last;
+    w.device = (const uint8_t*) alias;
+    dax_windows_.push_back(w);
+    return true;
+}
+
+bool FileExpertSource::dax_unregister(size_t index) {
+    const DaxWindow w = dax_windows_[index];
+    dax_windows_.erase(dax_windows_.begin() + (std::ptrdiff_t) index);
+    const cudaError_t unreg = cudaHostUnregister((void*) (base_ + w.off));
+    if (unreg != cudaSuccess) {
+        std::fprintf(stderr, "FileExpertSource: STRATA_REGISTER_DAX: cudaHostUnregister of layers %lld..%lld failed: %s\n",
+                     (long long) w.first, (long long) w.last, cudaGetErrorString(unreg));
+        (void) cudaGetLastError();
+        return false;
+    }
+    return true;
+}
+
+bool FileExpertSource::dax_register_run(int64_t first) {
+    if (first < 0 || first >= n_layers_ || (size_t) first >= layer_blob_bytes_.size()) return false;
+    int64_t last = first;
+    if (!dax_fit(first, last)) {
+        std::fprintf(stderr,
+                     "FileExpertSource: STRATA_REGISTER_DAX: layer %lld (%.2f GiB) does not fit the %.2f GiB "
+                     "window; it stays on the pageable path\n",
+                     (long long) first, (double) (layer_end(first) - layer_begin(first)) / 1073741824.0,
+                     (double) dax_budget_ / 1073741824.0);
+        return false;
+    }
+    // The driver caps total registered host memory BELOW any budget we could ask for, and where it caps is the
+    // driver's business, not ours: if the full run is refused, give back one layer at a time rather than leave
+    // the cursor with no window at all.
+    for (; last >= first; --last) {
+        if (dax_register(first, last)) return true;
+        if (last == first) break;
+    }
+    return false;
+}
+
+void FileExpertSource::set_dma_stream(void* stream) { dax_stream_ = stream; }
+
+// The sliding window's only moving part, and the reason `pinned()` cannot be its driver.
+//
+// The prompt path's ISSUE step calls this once per layer, immediately before the layer's first copy is enqueued
+// (`dma_ready` told it, at job-build time, that every layer of the chunk is DMA-able, and this is what makes that
+// true layer by layer).  When the window already covers the layer - the common case, ~6 layers out of every
+// rotation - this is a linear scan of a handful of windows and no driver calls at all.
+//
+// ROTATION, AND THE RULE THAT MAKES THE UNREGISTER SAFE.  A window is released only after the copy stream has
+// been synchronised, because the copy engine reads the released bytes directly out of host memory: a
+// `cudaHostUnregister` that lands while a `cudaMemcpyAsync` from that range is still in flight is a
+// use-after-unmap, and the driver does not defend against it.  On top of that barrier the stalest window goes
+// first (the one whose `last` layer is lowest, i.e. the one the stream has moved past the furthest, always at
+// least one layer behind the layer being registered), so the synchronise is waiting on as little as possible.
+// Both, not either: the sync is what makes the release provably safe on a delay path this code does not control,
+// and the order is what keeps it cheap.
+//
+// NOT CALLED FROM DECODE.  `begin_layer` is the decode path's per-layer hook and it must never rotate: a decode
+// visits all 48 layers per token, so rotating there would be 48 unregister/register pairs a token, against 48
+// for an entire prompt here.  The consequence is that the window is FROZEN at whatever the last prompt chunk
+// left it, which is why `pinned()` is not the prompt path's gate: it would report those few layers and stage
+// every other one through the copy threads.
+bool FileExpertSource::prepare_layer(int64_t layer) {
+    if (!dax_ok_ || base_ == nullptr) return false;
+    if (layer < 0 || layer >= n_layers_) return false;
+    if (dax_window_of(layer) != nullptr) return true;
+    int64_t last = 0;
+    if (!dax_fit(layer, last)) return false;   // bigger than the whole budget: never DMA-able, never retried
+    const bool timing = dax_timing_;
+    const auto ms_since = [](const std::chrono::steady_clock::time_point& t) {
+        return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t).count();
+    };
+    const auto t_rot = std::chrono::steady_clock::now();
+    double wait_ms = 0.0, unreg_ms = 0.0, reg_ms = 0.0;
+    if (!dax_windows_.empty()) {
+        const uint64_t need = page_up(layer_end(last)) - page_down(layer_begin(layer));
+        if (dax_stream_ != nullptr) {
+            const auto tw = std::chrono::steady_clock::now();
+            const cudaError_t sync = cudaStreamSynchronize((cudaStream_t) dax_stream_);
+            wait_ms += ms_since(tw);
+            if (sync != cudaSuccess) {
+                std::fprintf(stderr,
+                             "FileExpertSource: STRATA_REGISTER_DAX: the copy stream did not drain before a "
+                             "rotation (%s); layer %lld stays on the pageable path\n",
+                             cudaGetErrorString(sync), (long long) layer);
+                (void) cudaGetLastError();
+                return false;   // **NO ROTATION WITHOUT THE BARRIER** - a released range must never be in flight
+            }
+        }
+        uint64_t held = 0;
+        for (const DaxWindow& w : dax_windows_) held += w.bytes;
+        while (!dax_windows_.empty() && held + need > dax_budget_) {
+            size_t victim = 0;
+            for (size_t i = 1; i < dax_windows_.size(); ++i)
+                if (dax_windows_[i].last < dax_windows_[victim].last) victim = i;
+            held -= dax_windows_[victim].bytes;
+            const auto tu = std::chrono::steady_clock::now();
+            (void) dax_unregister(victim);
+            unreg_ms += ms_since(tu);
+        }
+    }
+    const auto t_reg = std::chrono::steady_clock::now();
+    if (!dax_register_run(layer)) {
+        // One refused rotation disables the window for the rest of the run: every later layer then answers
+        // `dma_ready` false and is staged exactly as the baseline stages it, instead of paying a failing driver
+        // call per layer.  Loud, because it is the difference between the two arms of the A/B.
+        std::fprintf(stderr,
+                     "FileExpertSource: STRATA_REGISTER_DAX: rotation to layer %lld failed; the sliding window is "
+                     "disabled and the rest of the run keeps its host copies\n",
+                     (long long) layer);
+        dax_ok_ = false;
+        return false;
+    }
+    reg_ms = ms_since(t_reg);
+    ++dax_rotations_;
+    // Once per rotation, never per blob: the layer range moved and how many bytes that cost.
+    std::fprintf(stderr, "FileExpertSource: STRATA_REGISTER_DAX: rotation %lld: window now layers %lld..%lld, %.2f GiB\n",
+                 (long long) dax_rotations_, (long long) dax_windows_.back().first,
+                 (long long) dax_windows_.back().last, (double) dax_windows_.back().bytes / 1073741824.0);
+    if (timing)
+        std::fprintf(stderr,
+                     "FileExpertSource: STRATA_DAX_TIMING: rotation %lld: register %.1f ms, unregister %.1f ms, "
+                     "wait %.1f ms, rotation %.1f ms\n",
+                     (long long) dax_rotations_, reg_ms, unreg_ms, wait_ms, ms_since(t_rot));
+    std::fflush(stderr);
+    return true;
+}
