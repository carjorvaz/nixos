+// OR wholly outside every one of them.  A source that BEGINS inside a registration and ends outside it is taken
+// as page-locked and the driver refuses the copy (cudaErrorInvalidValue; probe /data/refill-straddle.cu P2/P3),
+// which aborts the request with "an adaptive refill failed".  `FileExpertSource`'s arena partial pin already
+// cuts itself "at an expert boundary" for exactly this reason.  Three things can cut a blob:
+//   1. two adjacent blobs of ONE batch sharing a rounded page - fixed by the merge in the pin path;
+//   2. a span still held from an EARLIER batch (or from an earlier request, when a pin outlived its request);
+//   3. the DAX window's own page-rounded edges: `dax_register` registers
+//      [page_down(layer_begin(first)), page_up(layer_end(last))), so it can cut a blob of the layer BEFORE
+//      `first` or AFTER `last` in half.  Such a blob reports `Pageable` (dax_holds is containment-only), so the
+//      refill registers the blob's span itself - refused, "already mapped" - and then copies it from its own
+//      pointer: the fatal geometry, in a request that looks completely ordinary.
+// This guard keeps a registry of every range the pin path and the source hold registered and, per batch:
+//   * refuses to register a candidate span that only PARTLY overlaps one of them (drop), and
+//   * stages a blob that still only partly overlaps one through a pinned scratch buffer instead of copying it
+//     from its own pointer (bounce),
+// so no copy can straddle a registration again.  Nothing here runs when STRATA_REFILL_PIN_SRC is unset.
+// STRATA_PIN_FIX=0 restores the pre-fix behaviour (a diagnostic escape hatch, NOT a supported configuration);
+// STRATA_PIN_TRACE=1 prints the registry and every decision.
+namespace {
+struct HostReg {
+    uintptr_t a = 0, e = 0;
+    int64_t batch = 0;
+    const char* kind = "?";
+};
+std::mutex g_pin_mu;
+std::vector<HostReg> g_pin_live;      // registered by the refill pin path and still registered
+std::vector<HostReg> g_pin_foreign;   // registered by the expert source itself (the DAX window, a pinned arena)
+int64_t g_pin_batch = 0;
+int64_t g_pin_violations = 0;
+
+bool pin_trace_on() {
+    static const bool v = std::getenv("STRATA_PIN_TRACE") != nullptr;
+    return v;
+}
+/// The fix is on whenever the pin path is (STRATA_PIN_FIX=0 restores the pre-fix behaviour, diagnostics only).
+bool pin_fix_on() {
+    static const bool v = [] {
+        const char* e = std::getenv("STRATA_PIN_FIX");
+        return e == nullptr || std::atoi(e) != 0;
+    }();
+    return v;
+}
+/// Any intersection with a registered range that is NOT containment - exactly the geometry the driver refuses.
+bool pin_overlap_partial(uintptr_t a, uintptr_t e, HostReg* hit) {
+    std::lock_guard<std::mutex> lk(g_pin_mu);
+    for (const std::vector<HostReg>* v : {&g_pin_live, &g_pin_foreign}) {
+        for (const HostReg& r : *v) {
+            if (a < r.e && r.a < e && !(a >= r.a && e <= r.e)) {
+                if (hit != nullptr) *hit = r;
+                return true;
+            }
+        }
+    }
+    return false;
+}
+size_t pin_live_count() {
+    std::lock_guard<std::mutex> lk(g_pin_mu);
+    return g_pin_live.size();
+}
+void pin_note_register(uintptr_t a, uintptr_t e, int64_t batch, const char* kind) {
+    std::lock_guard<std::mutex> lk(g_pin_mu);
+    g_pin_live.push_back(HostReg{a, e, batch, kind});
+}
+void pin_note_unregister(uintptr_t a) {
+    std::lock_guard<std::mutex> lk(g_pin_mu);
+    for (size_t i = 0; i < g_pin_live.size(); ++i)
+        if (g_pin_live[i].a == a) {
+            g_pin_live.erase(g_pin_live.begin() + (ptrdiff_t) i);
+            return;
+        }
+}
+/// The ranges the expert source itself holds registered (the DAX windows, a pinned complement).  Asked for once
+/// per batch: a window rotates only in the prompt path's issue step, never inside the decode.
+void pin_note_source(const strata::core::ExpertSource* src) {
+    std::vector<std::pair<uintptr_t, size_t>> got;
+    if (src != nullptr) src->registered_ranges(got);
+    std::lock_guard<std::mutex> lk(g_pin_mu);
+    g_pin_foreign.clear();
+    for (const auto& r : got) g_pin_foreign.push_back(HostReg{r.first, r.first + r.second, 0, "source"});
+}
+void pin_trace_registry(const char* what) {
+    if (!pin_trace_on()) return;
+    std::lock_guard<std::mutex> lk(g_pin_mu);
+    std::fprintf(stderr, "PINTRACE %s: batch %lld, %zu live pin spans, %zu source ranges\n", what,
+                 (long long) g_pin_batch, g_pin_live.size(), g_pin_foreign.size());
+    for (const HostReg& r : g_pin_live)
+        std::fprintf(stderr, "PINTRACE   held [%zx,+%llu) batch %lld age %lld (%s)\n", (size_t) r.a,
+                     (unsigned long long) (r.e - r.a), (long long) r.batch,
+                     (long long) (g_pin_batch - r.batch), r.kind);
+    for (const HostReg& r : g_pin_foreign)
+        std::fprintf(stderr, "PINTRACE   source [%zx,+%llu)\n", (size_t) r.a, (unsigned long long) (r.e - r.a));
+}
+/// The pinned scratch a straddling blob is staged through: one host memcpy plus the same H2D copy, so the driver
+/// never sees the mapping.  Reused, so a staged copy waits for the previous one to be read.
+struct PinBounce {
+    uint8_t* buf = nullptr;
+    size_t cap = 0;
+    cudaEvent_t done = nullptr;
+    bool in_flight = false;
+
+    bool ensure(size_t need) {
+        if (cap >= need) return true;
+        if (buf != nullptr) {
+            if (in_flight && cudaEventSynchronize(done) != cudaSuccess) return false;
+            in_flight = false;
+            (void) cudaFreeHost(buf);
+            buf = nullptr;
+            cap = 0;
+        }
+        if (cudaHostAlloc((void**) &buf, need, cudaHostAllocDefault) != cudaSuccess) {
+            (void) cudaGetLastError();
+            buf = nullptr;
+            return false;
+        }
+        if (done == nullptr) (void) cudaEventCreateWithFlags(&done, cudaEventDisableTiming);
+        cap = need;
+        return true;
+    }
+    bool stage(const uint8_t* src, uint8_t* dest, size_t bytes, cudaStream_t st) {
+        if (!ensure(bytes)) return false;
+        if (in_flight) {
+            if (cudaEventSynchronize(done) != cudaSuccess) return false;
+            in_flight = false;
+        }
+        std::memcpy(buf, src, bytes);
+        if (cudaMemcpyAsync(dest, buf, bytes, cudaMemcpyHostToDevice, st) != cudaSuccess) return false;
+        (void) cudaEventRecord(done, st);
+        in_flight = true;
+        return true;
+    }
+};
+}  // namespace
