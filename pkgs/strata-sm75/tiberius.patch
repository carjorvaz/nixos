+                         "FileExpertSource: STRATA_REGISTER_DAX ignored: cudaHostRegister of a %.2f GiB window "
+                         "failed - the mapping stays pageable and the prompt path keeps its host copies (the flag "
+                         "needs a kernel with fsdax_longterm_pin=1)\n",
+                         (double) dax_budget_ / 1073741824.0);
+        }
+        std::fflush(stderr);
+    }
+
     return true;
