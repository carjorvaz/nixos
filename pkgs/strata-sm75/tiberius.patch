+uint64_t page_down(uint64_t v) {
+    const uint64_t p = host_page_size();
+    return v / p * p;
+}
+uint64_t page_up(uint64_t v) {
+    const uint64_t p = host_page_size();
+    return (v + p - 1) / p * p;
