+    if (image.live.ids.empty() || !image_keys(image.live.imgs, image.live.ids.size()) ||
+        std::any_of(image.live.ids.begin(), image.live.ids.end(), [](int32_t id) { return id < 0; }))
+        return fail(error, "invalid live token/image metadata");
+    for (const auto& c : image.checkpoints) {
+        if (!c.stage_parts.empty() || c.ids.empty() || c.ids.size() > image.live.ids.size() ||
+            !std::equal(c.ids.begin(), c.ids.end(), image.live.ids.begin()))
+            return fail(error, "checkpoint is not a live token prefix");
+        size_t img = 0;
+        for (const auto& key : image.live.imgs) {
+            if ((uint64_t) key.start >= c.ids.size()) break;
+            if (img >= c.imgs.size() || !(c.imgs[img++] == key))
+                return fail(error, "checkpoint image identity differs");
+        }
+        if (img != c.imgs.size()) return fail(error, "checkpoint image prefix differs");
+    }
+    // the running-state byte sizes the file carries must be exactly this session's (they are copied, not streamed)
+    ConversationStateSizes z;
+    if (!conversation_session_sizes(g, ss, z, error)) return false;
+    const size_t layers = owned_qsa(ss);
+    size_t tails = 0, dead = 0, block_pos = 0;
+    if (!conversation_detail::product(tails, {layers, z.tail}) ||
+        !conversation_detail::product(dead, {layers, z.dead}) ||
+        !conversation_detail::product(block_pos, {layers, z.block_pos}))
+        return fail(error, "indexer byte count overflow");
+    const std::array<uint64_t, 5> want = {z.gdn, ss.ple_hist ? z.ple : 0, tails, dead, block_pos};
