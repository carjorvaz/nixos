+struct alignas(16) F16x8 {
+    uint16_t v[8];
+};
+
+/// bf16 -> fp16, 8 elements per thread, round-to-nearest.
+__global__ void bf16_to_f16_kernel(const F16x8* __restrict__ src, F16x8* __restrict__ dst, long long n) {
+    const long long i = (long long) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    const F16x8 a = src[i];
+    F16x8 b;
+#pragma unroll
+    for (int k = 0; k < 8; ++k)
+        b.v[k] = __half_as_ushort(__float2half_rn(__bfloat162float(__ushort_as_bfloat16(a.v[k]))));
+    dst[i] = b;
+}
+
+/// The unaligned / tail form: one element per thread.
+__global__ void bf16_to_f16_scalar_kernel(const uint16_t* __restrict__ src, uint16_t* __restrict__ dst,
+                                          long long n) {
+    const long long i = (long long) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    dst[i] = __half_as_ushort(__float2half_rn(__bfloat162float(__ushort_as_bfloat16(src[i]))));
+}
+
+inline bool aligned16(const void* p) { return (reinterpret_cast<uintptr_t>(p) & 15u) == 0; }
+
+void bf16_to_f16(const uint16_t* src, uint16_t* dst, int64_t n, cudaStream_t stream) {
+    if (n <= 0) return;
+    int64_t done = 0;
+    if (aligned16(src) && aligned16(dst)) {
+        const int64_t n8 = n >> 3;
+        if (n8 > 0) {
+            bf16_to_f16_kernel<<<(unsigned) ((n8 + 255) / 256), 256, 0, stream>>>((const F16x8*) src,
+                                                                                  (F16x8*) dst, (long long) n8);
+            done = n8 << 3;
+        }
+    }
+    if (done < n)
+        bf16_to_f16_scalar_kernel<<<(unsigned) ((n - done + 255) / 256), 256, 0, stream>>>(src + done, dst + done,
+                                                                                           (long long) (n - done));
+}
+
+/// STRATA_GEMM_DEBUG=1 only: max|v|, the count of non-finite values and the first index outside
+/// fp16's finite range, for a bf16 or fp16 buffer.  This is the evidence for the range
+/// precondition, and it blocks on the stream, so it must never be on for a measurement.
+struct Scan {
+    float max_abs = -1.0f;
+    long long nonfinite = -1;
+    long long first_big = -1;   // first index with |v| > 65504, -1 when there is none
+};
+
+__global__ void scan_kernel(const uint16_t* __restrict__ src, long long n, int as_bf16, float* __restrict__ fout,
+                            long long* __restrict__ lout) {
+    float m = 0.0f;
+    long long nf = 0;
+    for (long long i = (long long) blockIdx.x * blockDim.x + threadIdx.x; i < n;
+         i += (long long) gridDim.x * blockDim.x) {
+        const uint16_t b = src[i];
+        if (as_bf16) {
+            if ((b & 0x7F80u) == 0x7F80u) ++nf;
+            const float f = __bfloat162float(__ushort_as_bfloat16(b));
+            const float a = fabsf(f);
+            if (a > m) m = a;
+            if (a > 65504.0f) atomicMin((long long*) &lout[1], (long long) i);
+        } else {
+            if ((b & 0x7C00u) == 0x7C00u) ++nf;
+            const float f = __half2float(__ushort_as_half(b));
+            const float a = fabsf(f);
+            if (a > m) m = a;
+            if (a > 65504.0f) atomicMin((long long*) &lout[1], (long long) i);
+        }
+    }
+    if (m > 0.0f) atomicMax((int*) fout, __float_as_int(m));
+    if (nf > 0) atomicAdd((unsigned long long*) &lout[0], (unsigned long long) nf);
+}
+
+__global__ void scan_init_kernel(float* __restrict__ fout, long long* __restrict__ lout) {
+    fout[0] = 0.0f;
+    lout[0] = 0;
+    lout[1] = 0x7FFFFFFFFFFFFFFFll;
+}
+
+/// The fp32 (engine output) form: max|v| and the number of non-finite values.
+__global__ void scan_f32_kernel(const float* __restrict__ src, long long n, float* __restrict__ fout,
+                                long long* __restrict__ lout) {
+    float m = 0.0f;
+    long long nf = 0;
+    for (long long i = (long long) blockIdx.x * blockDim.x + threadIdx.x; i < n;
+         i += (long long) gridDim.x * blockDim.x) {
+        const float f = src[i];
+        if (!isfinite(f)) ++nf;
+        const float a = fabsf(f);
+        if (a > m) m = a;
+    }
+    if (m > 0.0f) atomicMax((int*) fout, __float_as_int(m));
+    if (nf > 0) atomicAdd((unsigned long long*) &lout[0], (unsigned long long) nf);
+}
+
+Scan debug_scan_f32(const float* src, int64_t n, cudaStream_t stream) {
+    static float* fbuf = nullptr;
+    static long long* lbuf = nullptr;
+    Scan r;
+    if (src == nullptr || n <= 0) return r;
+    if (fbuf == nullptr && (cudaMalloc(&fbuf, sizeof(float)) != cudaSuccess ||
+                            cudaMalloc(&lbuf, 2 * sizeof(long long)) != cudaSuccess))
+        return r;
+    scan_init_kernel<<<1, 1, 0, stream>>>(fbuf, lbuf);
+    scan_f32_kernel<<<128, 256, 0, stream>>>(src, (long long) n, fbuf, lbuf);
+    float hf = 0.0f;
+    long long hl[2] = {0, 0};
+    if (cudaMemcpyAsync(&hf, fbuf, sizeof(float), cudaMemcpyDeviceToHost, stream) != cudaSuccess) return r;
+    if (cudaMemcpyAsync(hl, lbuf, 2 * sizeof(long long), cudaMemcpyDeviceToHost, stream) != cudaSuccess) return r;
+    cudaStreamSynchronize(stream);
+    r.max_abs = hf;
+    r.nonfinite = hl[0];
+    r.first_big = -1;
+    return r;
+}
+
+Scan debug_scan(const uint16_t* src, int64_t n, int as_bf16, cudaStream_t stream) {
+    static float* fbuf = nullptr;
+    static long long* lbuf = nullptr;
+    Scan r;
+    if (src == nullptr || n <= 0) return r;
+    if (fbuf == nullptr && (cudaMalloc(&fbuf, sizeof(float)) != cudaSuccess ||
+                            cudaMalloc(&lbuf, 2 * sizeof(long long)) != cudaSuccess))
+        return r;
+    scan_init_kernel<<<1, 1, 0, stream>>>(fbuf, lbuf);
+    scan_kernel<<<128, 256, 0, stream>>>(src, (long long) n, as_bf16, fbuf, lbuf);
+    float hf = 0.0f;
+    long long hl[2] = {0, 0};
+    if (cudaMemcpyAsync(&hf, fbuf, sizeof(float), cudaMemcpyDeviceToHost, stream) != cudaSuccess) return r;
+    if (cudaMemcpyAsync(hl, lbuf, 2 * sizeof(long long), cudaMemcpyDeviceToHost, stream) != cudaSuccess) return r;
+    cudaStreamSynchronize(stream);
+    r.max_abs = hf;
+    r.nonfinite = hl[0];
+    r.first_big = hl[1] == 0x7FFFFFFFFFFFFFFFll ? -1 : hl[1];
