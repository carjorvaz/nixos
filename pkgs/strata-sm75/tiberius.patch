+}
+
+bool conversation_snapshot_stream_sinks(std::vector<SessionKvSink>& sinks, const SessionStreamMeta& meta,
+                                        const SessionState& ss, const ModelGeometry& g, const QsaState* draft,
+                                        std::string& error) {
+    const size_t layers = owned_qsa(ss);
+    const size_t n = layers + (draft ? 1 : 0);
+    if (meta.image.kv.size() != n || meta.kv_part_bytes.size() != n)
+        return fail(error, "invalid K/V layer count");
+    const int64_t upto = (int64_t) meta.image.live.ids.size();
+    std::vector<SessionKvSink> built(n);
+    for (size_t j = 0; j < layers; ++j)
+        if (!conversation_kv_sink(built[j], owned(ss, j), g, upto, true, error)) return false;
+    if (draft && !conversation_kv_sink(built.back(), *draft, g, upto, false, error)) return false;
+    for (size_t j = 0; j < n; ++j) {
+        const ConversationKv& h = meta.image.kv[j];
+        const SessionKvSink& b = built[j];
+        bool same = b.format == h.format && b.cells == h.cells && b.heads == h.heads && b.head_dim == h.head_dim &&
+                    b.page_size == h.page_size && b.pooled_rows == h.pooled_rows && b.idx_dim == h.idx_dim;
+        for (size_t part = 0; same && part < 5; ++part)
+            same = meta.kv_part_bytes[j][part] == (uint64_t) b.sizes[part];
+        if (!same) return fail(error, "saved K/V header does not match this engine's K/V layout");
+    }
+    sinks = std::move(built);
+    return true;
+}
+
+bool conversation_snapshot_stream_finish(const std::vector<SessionKvSink>& sinks, const SessionState& ss,
+                                         const ModelGeometry& g, const QsaState* draft, int64_t upto,
+                                         std::string& error) {
+    const size_t layers = owned_qsa(ss);
+    if (sinks.size() != layers + (draft ? 1 : 0)) return fail(error, "invalid streamed K/V layer count");
+    for (size_t j = 0; j < layers; ++j)
+        if (!conversation_kv_sink_finish(sinks[j], owned(ss, j), g, upto, true, error)) return false;
+    return !draft || conversation_kv_sink_finish(sinks.back(), *draft, g, upto, false, error);
+}
