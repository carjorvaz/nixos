+/// The rank-ordered, size-capped host tier: same sentinel and offset table as the full complement, but the
+/// walk follows the profile's ranking and stops at the first blob that would exceed `budget`.
+bool make_ranked_complement_plan(int64_t n_layers, int64_t n_expert,
+                                 const std::vector<uint64_t>& layer_blob_bytes,
+                                 const std::vector<std::pair<int32_t, int32_t>>& primary_gpu_pairs,
+                                 const std::vector<std::pair<int32_t, int32_t>>& ranked, uint64_t budget,
+                                 std::vector<uint64_t>& offsets, uint64_t& bytes, std::string& err) {
+    if (n_layers <= 0 || n_expert <= 0 || layer_blob_bytes.size() != (size_t) n_layers) {
+        err = "FileExpertSource: invalid geometry for the ranked host tier";
+        return false;
+    }
+    const size_t count = (size_t) n_layers * (size_t) n_expert;
+    std::vector<uint8_t> in_gpu(count, 0);
+    for (const auto& p : primary_gpu_pairs) {
+        if (p.first < 0 || p.second < 0 || p.first >= n_layers || p.second >= n_expert) continue;
+        in_gpu[(size_t) p.first * (size_t) n_expert + (size_t) p.second] = 1;
+    }
+    offsets.assign(count, kNoCacheComplement);
+    bytes = 0;
+    for (const auto& p : ranked) {
+        if (p.first < 0 || p.second < 0 || p.first >= n_layers || p.second >= n_expert) continue;
+        const size_t index = (size_t) p.first * (size_t) n_expert + (size_t) p.second;
+        if (in_gpu[index] != 0 || offsets[index] != kNoCacheComplement) continue;
+        const uint64_t blob_bytes = layer_blob_bytes[(size_t) p.first];
+        if (blob_bytes == 0) continue;
+        if (bytes + blob_bytes > budget) break;   // rank order: stop at the first that does not fit
+        offsets[index] = bytes;
+        bytes += blob_bytes;
+    }
+    return true;
+}
