+        return fail(error, "snapshot from another session layer range");
+    if (!image.live.stage_parts.empty()) return fail(error, "live.stage_parts in a session file");
+    // metadata only: pass 1 leaves every running-state array EMPTY (sizes are recorded in meta.state_bytes), so this
+    // must not go through view_validate -> conversation_checkpoint_validate, which compares those arrays' sizes.  The
+    // file's recorded sizes are checked against this session below; pass 2 materialises the arrays.
