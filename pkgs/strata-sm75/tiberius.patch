diff --git a/include/strata/core/expert_source.hpp b/include/strata/core/expert_source.hpp
index ca325ae..117d881 100644
--- a/include/strata/core/expert_source.hpp
+++ b/include/strata/core/expert_source.hpp
@@ -217,9 +217,50 @@ public:
     /// asynchronous host-to-device copy can DMA it directly (no staging copy on the CPU).
     virtual bool pinned(int64_t layer, int64_t expert) const { (void) layer; (void) expert; return false; }
 
+    /// tiberius (STRATA_REGISTER_DAX): whether the blob will be DMA-able **at the moment the prompt path issues its
+    /// copy**, which is not the same question as `pinned()` when a source registers its DMA window lazily.
+    ///
+    /// The sliding DAX window (`STRATA_REGISTER_DAX`) covers `STRATA_REGISTER_DAX_MIB` of the 46.84 GiB pack and
+    /// moves as the prefill streams it, so `pinned()` - a snapshot of what is registered RIGHT NOW - is false for
+    /// the layers the stream has not reached yet.  The streamed ring, though, builds its whole chunk's job list
+    /// (and therefore decides direct-DMA vs host-copy-stager) before it issues a single copy, and it issues the
+    /// layers in order: it must ask this, and it must call `prepare_layer` to make the answer true.  Every source
+    /// that does not move a window answers exactly as `pinned()` does, so the distinction costs it nothing.
+    virtual bool dma_ready(int64_t layer, int64_t expert) const { return pinned(layer, expert); }
+    /// Which pool of host memory `blob(layer, expert)` names.  `pinned()` answers "can the copy engine read
+    /// this directly"; this says *why*, which is what the refill needs both to report where its copies came
+    /// from and to decide which of them need a CPU staging hop: the driver stages a DMA out of pageable host
+    /// memory through an internal bounce buffer (measured 2.4 GB/s here against 6.9 GB/s from registered
+    /// memory), so a source that can say "pageable" lets the caller stage it itself and pipeline it.
+    enum class BlobClass {
+        Registered,  ///< inside a CUDA-registered range: direct DMA
+        PinnedTier,  ///< the pinned cache complement / a pinned arena: direct DMA
+        Pageable,    ///< an ordinary mapping the copy engine must bounce
+        Arena,       ///< anonymous resident memory that is NOT registered: the copy engine bounces it too
+    };
+    virtual BlobClass blob_class(int64_t layer, int64_t expert) const {
+        (void) layer;
+        (void) expert;
+        return BlobClass::Pageable;
