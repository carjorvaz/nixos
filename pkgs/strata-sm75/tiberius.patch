+// ================================ STRATA_REGISTER_DAX: THE WINDOWS ================================
+//
+// The window covering `layer`, or null.  Windows are disjoint and few - the budget holds a handful of ~1 GiB
+// layers - so a linear scan is the whole lookup, and it is what `pinned()` and `device_alias()` do per blob.
+const FileExpertSource::DaxWindow* FileExpertSource::dax_window_of(int64_t layer) const {
+    if (layer < 0 || layer >= n_layers_) return nullptr;
+    for (const DaxWindow& w : dax_windows_)
+        if (layer >= w.first && layer <= w.last) return &w;
+    return nullptr;
+}
+
+// Is the blob wholly inside the window that covers `layer`, and at what offset from the window's start?  The
+// test is containment, not overlap: a blob that is only partly inside stays on the pageable path.  `mapped_blob`
+// does the layer/expert and blob-bounds validation against the mapping itself.
+bool FileExpertSource::dax_holds(int64_t layer, int64_t expert, const DaxWindow*& window, uint64_t& offset) const {
+    window = nullptr;
+    const DaxWindow* w = dax_window_of(layer);
+    if (w == nullptr) return false;
+    const uint8_t* mapped = mapped_blob(layer, expert);
+    if (mapped == nullptr) return false;
+    const uint64_t off = (uint64_t) (mapped - base_);   // >= 0: mapped_blob returns an address inside the mapping
+    if (off < w->off) return false;
+    const uint64_t rel = off - w->off;
+    if (rel > w->bytes || layer_blob_bytes_[(size_t) layer] > w->bytes - rel) return false;
+    window = w;
+    offset = rel;
+    return true;
+}
+
+// How far one registration can reach from `first`: the largest run of whole layers whose PAGE-ALIGNED span fits
+// the budget.  False when even `first` alone does not fit, i.e. a layer bigger than the whole budget - a layer
+// that can never be DMA-able, which is why `dma_ready` answers false for it and the prefill stages it as before.
+bool FileExpertSource::dax_fit(int64_t first, int64_t& last) const {
+    if (first < 0 || first >= n_layers_ || (size_t) first >= layer_blob_bytes_.size()) return false;
+    const uint64_t begin = page_down(layer_begin(first));
+    if (page_up(layer_end(first)) - begin > dax_budget_) return false;
+    int64_t b = first;
+    while (b + 1 < n_layers_ && page_up(layer_end(b + 1)) - begin <= dax_budget_) ++b;
+    last = b;
+    return true;
+}
+
+bool FileExpertSource::dax_register(int64_t first, int64_t last) {
+    const uint64_t off = page_down(layer_begin(first));
+    const uint64_t end = page_up(layer_end(last));
+    if (end <= off || end - off > dax_budget_) return false;
+    // ReadOnly: the engine only ever reads the pack through this alias, and the device must not write it.
+    // Mapped: the device needs an alias to read through.  Portable: the alias is valid in every context.
+    const cudaError_t reg = cudaHostRegister((void*) (base_ + off), (size_t) (end - off),
+                                             cudaHostRegisterReadOnly | cudaHostRegisterMapped |
+                                                 cudaHostRegisterPortable);
+    if (reg != cudaSuccess) {
+        std::fprintf(stderr,
+                     "FileExpertSource: STRATA_REGISTER_DAX: cudaHostRegister of layers %lld..%lld (%.2f GiB at "
+                     "offset %llu) failed: %s\n",
+                     (long long) first, (long long) last, (double) (end - off) / 1073741824.0,
+                     (unsigned long long) off, cudaGetErrorString(reg));
+        // **CONSUME THE ERROR, OR IT LIES ABOUT SOMETHING ELSE LATER** - the trap `PinnedArena` documents at
+        // length: until cudaGetLastError() reads it the failure is sticky, and the next reader is `gr_read`'s
+        // launch check, which would then report an out-of-memory for kernels that allocate nothing.  The failure
+        // is handled right here (the window stays where it was), so the state must not outlive that decision.
+        (void) cudaGetLastError();
+        return false;
+    }
+    void* alias = nullptr;
+    // `Mapped` only ASKS for the mapping: for a device that cannot do it the failure is deferred to this call
+    // (the runtime's own note on cudaHostRegisterMapped), so the alias is the real test.  A missing alias keeps
+    // the registration - the CPU reads it for free either way - and makes `device_alias()` report null for it.
+    const cudaError_t dev = cudaHostGetDevicePointer(&alias, (void*) (base_ + off), 0);
+    if (dev != cudaSuccess || alias == nullptr) {
+        (void) cudaGetLastError();
+        alias = nullptr;
+    }
+    DaxWindow w;
+    w.off = off;
+    w.bytes = end - off;
+    w.first = first;
+    w.last = last;
+    w.device = (const uint8_t*) alias;
+    dax_windows_.push_back(w);
+    return true;
+}
+
+bool FileExpertSource::dax_unregister(size_t index) {
+    const DaxWindow w = dax_windows_[index];
+    dax_windows_.erase(dax_windows_.begin() + (std::ptrdiff_t) index);
+    const cudaError_t unreg = cudaHostUnregister((void*) (base_ + w.off));
+    if (unreg != cudaSuccess) {
+        std::fprintf(stderr, "FileExpertSource: STRATA_REGISTER_DAX: cudaHostUnregister of layers %lld..%lld failed: %s\n",
+                     (long long) w.first, (long long) w.last, cudaGetErrorString(unreg));
+        (void) cudaGetLastError();
+        return false;
+    }
+    return true;
+}
+
+bool FileExpertSource::dax_register_run(int64_t first) {
+    if (first < 0 || first >= n_layers_ || (size_t) first >= layer_blob_bytes_.size()) return false;
+    int64_t last = first;
+    if (!dax_fit(first, last)) {
+        std::fprintf(stderr,
+                     "FileExpertSource: STRATA_REGISTER_DAX: layer %lld (%.2f GiB) does not fit the %.2f GiB "
+                     "window; it stays on the pageable path\n",
+                     (long long) first, (double) (layer_end(first) - layer_begin(first)) / 1073741824.0,
+                     (double) dax_budget_ / 1073741824.0);
+        return false;
+    }
+    // The driver caps total registered host memory BELOW any budget we could ask for, and where it caps is the
+    // driver's business, not ours: if the full run is refused, give back one layer at a time rather than leave
+    // the cursor with no window at all.
+    for (; last >= first; --last) {
+        if (dax_register(first, last)) return true;
+        if (last == first) break;
+    }
+    return false;
+}
