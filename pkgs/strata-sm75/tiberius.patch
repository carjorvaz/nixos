index 0000000..89a4e40
--- /dev/null
+++ b/include/strata/core/conversation_park_file.hpp
@@ -0,0 +1,249 @@
+// tiberius (pmem park spill): the file tier of the conversation cache.  A park the RAM cache refuses is written as a
+// v1 session file on /optane (XFS dax=always) and kept here as a metadata-only entry (ids/images/used, a few MB); a
+// later request restores it with the generation-103 streamed RESTORE.  Entries hold no K/V and no running state in
+// RAM, so this tier has its own byte budget / slot count / free-space reserve and never participates in the RAM
+// cache's budget, make_room() or evictable_bytes().  Host-only (no CUDA): testable off-box.
+#pragma once
+
+#include "strata/core/conversation_cache.hpp"
+#include "strata/core/conversation_file.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <deque>
+#include <filesystem>
+#include <string>
+#include <system_error>
+#include <utility>
+#include <vector>
+
+#if defined(_WIN32)
+#include <windows.h>
+#else
+#include <sys/statvfs.h>
+#endif
+
+namespace strata::core {
+
+// One parked conversation whose bytes live in `path` (a v1 session file).  Only the metadata needed to match a
+// prompt and validate the restore are in memory: the live conversation's ids/images and the deepest checkpoint's
+// ids/images (state arrays empty).  `serial` identifies the entry across deque index shifts.
+struct ParkedFile {
+    std::string path;
+    ConversationCheckpoint live;                      ///< ids/imgs/used only
+    std::vector<ConversationCheckpoint> checkpoints;  ///< metadata only: the parked chain (ids/images/used)
+    // The ONE checkpoint whose state arrays are in the file (the writer's deepest/pinned choice): the streamed
+    // restore can only rewind to this token count, so the matching exposes this checkpoint and never a mere metadata
+    // sibling.  0 = the file carries no checkpoint (live state only).
+    int64_t saved_tokens = 0;
+    bool cvec = false;
+    int64_t live_tokens = 0;
+    uint64_t bytes = 0;    ///< the file's size
+    uint64_t serial = 0;
+    int64_t used = 0;      ///< LRU stamp (monotone: newer is larger)
+};
+
+class ConversationParkFiles {
+public:
+    // The same shape as ConversationCache::Match so the request path can compare the two candidates.
+    struct Match {
+        size_t index = SIZE_MAX;
+        int64_t tokens = 0;
+        bool live = false;
+        uint64_t serial = 0;
+    };
+
+    // `budget`/`min_free`: this tier's own bytes and the free space the pmem filesystem must keep after a write.
+    bool init(const std::string& dir, uint64_t budget, size_t slots, uint64_t min_free, std::string& why) {
+        dir_ = dir;
+        budget_ = budget;
+        slots_ = slots;
+        min_free_ = min_free;
+        enabled_ = false;
+        why.clear();
+        if (dir.empty() || budget == 0 || slots == 0) {
+            why = "no park directory / budget / slots given";
+            return false;
+        }
+        std::error_code ec;
+        if (!std::filesystem::is_directory(dir, ec)) {
+            why = "park directory " + dir + " is not a directory";
+            return false;
+        }
+        // the free-space preflight is only meaningful on a filesystem we can stat
+        uint64_t free_bytes = 0;
+        if (!fs_free_bytes(free_bytes)) {
+            why = "cannot read the free space of " + dir;
+            return false;
+        }
+        enabled_ = true;
+        return true;
+    }
+    bool enabled() const { return enabled_; }
+    const std::string& dir() const { return dir_; }
+    size_t size() const { return entries_.size(); }
+    uint64_t bytes() const { return bytes_; }
+    size_t slots() const { return slots_; }
+    uint64_t budget() const { return budget_; }
+    uint64_t evictions() const { return evictions_; }
+    bool wants(int64_t tokens) const { return tokens > 0; }
+
+    // The longest file-parked conversation, for STRATA_KV_GROW_HOLD's trim bound.
+    int64_t longest_tokens() const {
+        int64_t n = 0;
+        for (const auto& e : entries_) n = std::max<int64_t>(n, e.live_tokens);
+        return n;
+    }
+
+    // Match rules are ConversationCache::best's: live entries first, then the deepest checkpoint; equal token counts
+    // prefer the newest entry, and the caller prefers RAM on a tie.  Read-only.
+    template <class Token>
+    Match best(const std::vector<Token>& prompt, const std::vector<ConversationImageKey>& images, bool cvec) const {
+        Match best;
+        if (!enabled_) return best;
+        for (size_t i = entries_.size(); i-- > 0;) {
+            const auto& e = entries_[i];
+            if (e.cvec != cvec) continue;
+            auto consider = [&](const ConversationCheckpoint& c, bool live) {
+                const int64_t n = conversation_prefix(c, prompt, images);
+                if (n > best.tokens) best = {i, n, live, e.serial};
+            };
+            consider(e.live, true);
+            for (const auto& c : e.checkpoints) {
+                // only the checkpoint the file actually carries state for can be restored (a rewind past it rereads)
+                if (e.saved_tokens > 0 && (int64_t) c.ids.size() == e.saved_tokens) consider(c, false);
+            }
+        }
+        return best;
+    }
+    // A file entry already holds this state (no LRU effect): used by park-gain to avoid rewriting the same conversation.
+    template <class Token>
+    bool holds(const std::vector<Token>& ids, const std::vector<ConversationImageKey>& images, bool cvec) const {
+        for (const auto& e : entries_) {
+            if (e.cvec != cvec) continue;
+            if (conversation_covers(e.live, ids, images)) return true;
+            for (const auto& c : e.checkpoints)
+                if (e.saved_tokens > 0 && (int64_t) c.ids.size() == e.saved_tokens &&
+                    conversation_covers(c, ids, images))
+                    return true;
+        }
+        return false;
+    }
+
+    // Pick a file name for a new park (caller then writes it): unique per process instance.
+    std::string next_path(uint64_t instance) const { return dir_ + "/" + std::to_string(instance) + "-" + std::to_string(serial_ + 1) + ".park"; }
+
+    // Free space / budget / slot preflight BEFORE writing `bytes`; admits the file without evicting anything (the
+    // eviction, if any, happens in put() so a failed write never destroys an existing file park).
+    bool admit(uint64_t bytes, std::string& why) const {
+        why.clear();
+        if (!enabled_) { why = "the file tier is off"; return false; }
+        if (bytes == 0) { why = "an empty park file"; return false; }
+        if (bytes > budget_) { why = "the park file would exceed the tier budget"; return false; }
+        if (slots_ == 0) { why = "no slots"; return false; }
+        uint64_t free_bytes = 0;
+        if (!fs_free_bytes(free_bytes)) { why = "cannot read the free space of " + dir_; return false; }
+        if (free_bytes < bytes || free_bytes - bytes < min_free_) {
+            why = "the filesystem has " + std::to_string(free_bytes >> 20) + " MiB free; a " +
+                  std::to_string(bytes >> 20) + " MiB park needs " + std::to_string(min_free_ >> 20) + " MiB kept free";
+            return false;
+        }
+        return true;
+    }
+    // Insert after the file was written: evict the least recently used FILE entries until slots/budget fit (never a
+    // RAM entry: this tier is separate), unlink the losers.  On failure the caller unlinks its new file.
+    bool put(ParkedFile&& f, std::string& why) {
+        why.clear();
+        if (!enabled_) { why = "the file tier is off"; return false; }
+        while ((entries_.size() >= slots_ || bytes_ + f.bytes > budget_) && !entries_.empty()) evict_front();
+        if (entries_.size() >= slots_ || bytes_ + f.bytes > budget_) {
+            why = "no slot / budget left in the file tier";
+            return false;
+        }
+        f.serial = ++serial_;
+        f.used = ++clock_;
+        bytes_ += f.bytes;
+        entries_.push_back(std::move(f));
+        return true;
+    }
+    // One line for STRATA_PARK_DEBUG: every entry's live tokens, the checkpoint tokens the file can rewind to and cvec.
+    std::string describe() const {
+        std::string out;
+        for (size_t i = 0; i < entries_.size(); ++i) {
+            const auto& e = entries_[i];
+            if (!out.empty()) out += ';';
+            out += "[" + std::to_string(i) + "] live=" + std::to_string(e.live_tokens) +
+                   " saved=" + std::to_string(e.saved_tokens) + " ckpts=" + std::to_string(e.checkpoints.size()) +
+                   " cvec=" + (e.cvec ? "1" : "0") + " bytes=" + std::to_string(e.bytes);
+        }
+        return out;
+    }
+    bool get(size_t index, ParkedFile& out) const {
+        if (index >= entries_.size()) return false;
+        out = entries_[index];
+        return true;
+    }
+    // Remove the entry; `unlink_file` deletes the file (a successful take ends persistence for that copy).
+    bool erase(size_t index, bool unlink_file) {
+        if (index >= entries_.size()) return false;
+        ParkedFile e = entries_[index];
+        entries_.erase(entries_.begin() + (std::ptrdiff_t) index);
+        bytes_ -= e.bytes;
+        if (unlink_file) unlink_path(e.path);
+        return true;
+    }
+    // Drop every entry and unlink the files (the #879 nan-flush sites).
+    size_t clear() {
+        const size_t n = entries_.size();
+        for (auto& e : entries_) unlink_path(e.path);
+        entries_.clear();
+        bytes_ = 0;
+        return n;
+    }
+    // Evict until `want` bytes are freed (LRU file entries only); used when the tier is over its budget.
+    size_t evict_to(uint64_t want_bytes) {
+        size_t n = 0;
+        while (bytes_ > want_bytes && !entries_.empty()) { evict_front(); ++n; }
+        return n;
+    }
+
+private:
+    static void unlink_path(const std::string& p) {
+        std::error_code ec;
+        std::filesystem::remove(p, ec);
+    }
+    bool fs_free_bytes(uint64_t& out) const {
+        out = 0;
+        if (dir_.empty()) return false;
+#if defined(_WIN32)
+        ULARGE_INTEGER free_bytes{};
+        std::wstring w(dir_.begin(), dir_.end());
+        if (!GetDiskFreeSpaceExW(w.c_str(), &free_bytes, nullptr, nullptr)) return false;
+        out = (uint64_t) free_bytes.QuadPart;
+        return true;
+#else
+        struct statvfs s{};
+        if (::statvfs(dir_.c_str(), &s) != 0) return false;
+        out = (uint64_t) s.f_bavail * (uint64_t) s.f_frsize;
+        return true;
+#endif
+    }
+    void evict_front() {
+        if (entries_.empty()) return;
+        ParkedFile e = std::move(entries_.front());
+        entries_.pop_front();
+        bytes_ -= e.bytes;
+        unlink_path(e.path);
+        ++evictions_;
+    }
+    std::string dir_;
+    uint64_t budget_ = 0;
+    size_t slots_ = 0;
+    uint64_t min_free_ = 0;
+    bool enabled_ = false;
+    size_t bytes_ = 0;
+    uint64_t clock_ = 0, serial_ = 0, evictions_ = 0;
+    std::deque<ParkedFile> entries_;   // least recently active first
+};
