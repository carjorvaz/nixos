+bool FileExpertSource::pinned(int64_t layer, int64_t expert) const {
+    // STRATA_REGISTER_DAX: memory inside a registered window IS pinned memory as far as the prompt path is
+    // concerned - the device reads the blob straight out of host memory - so every expert the window covers
+    // counts.  That is the CURRENT window: see `dma_ready` for what the stream should actually ask.
+    const DaxWindow* w = nullptr;
+    uint64_t offset = 0;
+    if (dax_holds(layer, expert, w, offset)) return true;
+    return complement_holds(layer, expert);
+}
+
+bool FileExpertSource::dma_ready(int64_t layer, int64_t expert) const {
+    // `pinned()` for a source that does not move a window, and the only question the streamed ring can ask: it
+    // builds the chunk's whole job list before it issues anything, so it cannot use a snapshot of the window.
+    if (pinned(layer, expert)) return true;
