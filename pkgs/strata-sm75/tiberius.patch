+    {
+        FileSource f(raw);
+        if (!f.ok()) { st.error = SessionError::memory; error = "session file: " + f.error(); return false; }
+        if (limits.progress) f.progress.emplace(limits.progress);   // pass 1 reports, pass 2 does not
+        f.expected = size;
+        if (!check_header(f)) return false;
+        const uint64_t payload = size - kHeader - kTrailer;
+        In in{&f, SessionHasher(0), payload, error, limits};
+        in.scratch = staging.get();
+        in.scratch_size = kBlock;
+        SessionStreamMeta parsed;
+        if (!stream_meta_payload(in, parsed)) { st.error = in.kind; return false; }
+        if (in.left) { error = "session file: payload has " + std::to_string(in.left) + " unparsed bytes"; return false; }
+        uint8_t t[kTrailer];
+        if (!f.read(t, kTrailer)) { st.error = f.kind(); error = "session file: trailer read error: " + f.error(); return false; }
+        uint64_t ph = 0;
+        std::memcpy(&ph, t, 8);
+        if (ph != in.hash.digest()) { error = "session file: payload checksum mismatch"; return false; }
+        if (std::memcmp(t + 8, kEnd, 8) != 0) { error = "session file: bad end marker"; return false; }
+        meta = std::move(parsed);
+    }
+    // ---- the RAM preflight, before pass 2 allocates the state copies; then the caller's prepare step
+    if (limits.admit) {
+        std::string why;
+        if (!limits.admit(session_stream_peak_bytes(meta), why)) {
+            st.error = SessionError::memory;
+            error = "session file: " + why;
+            return false;
+        }
+    }
+    if (target.prepare) {
+        std::string why;
+        if (!target.prepare(meta, why)) {
+            st.error = SessionError::invalid;
+            error = "session file: " + (why.empty() ? std::string("the engine refused the restored session") : why);
+            return false;
+        }
+    }
+    if (limits.phase) limits.phase("transfer", size);
+    // ---- pass 2: re-read the same descriptor, materialise the state copies, stream the K/V into the sinks
+    {
+        if (!raw.seek(0)) { st.error = raw.kind(); error = "session file: seek error: " + raw.error(); return false; }
+        FileSource f(raw);
+        if (!f.ok()) {
+            st.error = SessionError::memory;
+            error = "session file: " + f.error();
+            return false;
+        }
+        if (!check_header(f)) return false;
+        const uint64_t payload = size - kHeader - kTrailer;
+        In in{&f, SessionHasher(0), payload, error, limits};
+        in.scratch = staging.get();
+        in.scratch_size = kBlock;
+        struct TouchedOnThrow {
+            const In& in;
+            SessionStatus& st;
+            ~TouchedOnThrow() { st.touched = in.touched; }
+        } touched_on_throw{in, st};
+        if (!stream_load_payload(in, meta, target)) {
+            st.error = in.kind;
+            st.touched = in.touched;
+            if (!in.sink_error.empty() && error.find(in.sink_error) == std::string::npos) error = in.sink_error;
+            return false;
+        }
+        if (in.left) {
+            st.touched = in.touched;
+            error = "session file: payload has " + std::to_string(in.left) + " unparsed bytes";
+            return false;
+        }
+        uint8_t t[kTrailer];
+        if (!f.read(t, kTrailer)) {
+            st.error = f.kind();
+            st.touched = in.touched;
+            error = "session file: trailer read error: " + f.error();
+            return false;
+        }
+        uint64_t ph = 0;
+        std::memcpy(&ph, t, 8);
+        st.touched = in.touched;
+        if (ph != in.hash.digest()) { error = "session file: payload checksum mismatch"; return false; }
+        if (std::memcmp(t + 8, kEnd, 8) != 0) { error = "session file: bad end marker"; return false; }
+    }
+    if (target.finish) {
+        std::string why;
+        if (!target.finish(why)) {
+            st.error = SessionError::io;
+            error = "session file: " + (why.empty() ? std::string("the restored K/V could not be finished") : why);
+            return false;
+        }
+    }
+    bytes = (size_t) size;
+    st.error = SessionError::none;
+    return true;
+}
