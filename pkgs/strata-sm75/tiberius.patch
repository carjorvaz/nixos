diff --git a/src/core/conversation_park_file_test.cpp b/src/core/conversation_park_file_test.cpp
new file mode 100644
index 0000000..b8ea056
--- /dev/null
+++ b/src/core/conversation_park_file_test.cpp
@@ -0,0 +1,145 @@
+// CPU-only tests for the pmem park file tier (include/strata/core/conversation_park_file.hpp): budget/slot
+// accounting, LRU file-eviction (unlinks), matching identity (live and checkpoint prefixes, cvec), holds/scan-free
+// metadata round trip.  Built with the host-only clang/CMake test target; no CUDA, no model.
+#include "strata/core/conversation_park_file.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#ifndef _WIN32
+#include <unistd.h>
+#endif
+#include <fstream>
+#include <string>
+#include <vector>
+
+using namespace strata::core;
+namespace fs = std::filesystem;
+
+namespace {
+int checks = 0;
+void check(bool ok, const char* label) {
+    ++checks;
+    if (!ok) { std::fprintf(stderr, "FAIL: %s\n", label); std::exit(1); }
+}
+std::string write_file(const fs::path& dir, const char* name, size_t bytes) {
+    const fs::path p = dir / name;
+    std::ofstream f(p, std::ios::binary);
+    f << std::string(bytes, 'x');
+    f.close();
+    return p.string();
+}
+ParkedFile entry(uint64_t bytes, std::vector<int32_t> ids, std::vector<ConversationCheckpoint> checks_ = {}) {
+    ParkedFile f;
+    f.live.ids = std::move(ids);
+    f.live_tokens = (int64_t) f.live.ids.size();
+    f.checkpoints = std::move(checks_);
+    // what a park writes: the ONE checkpoint the streamed restore can rewind to (the writer's chosen one, normally
+    // the deepest chain checkpoint strictly shorter than the live state)
+    for (const auto& c : f.checkpoints)
+        if (c.ids.size() > (size_t) f.saved_tokens) f.saved_tokens = (int64_t) c.ids.size();
+    f.bytes = bytes;
+    return f;
+}
+long test_pid() {
+#if defined(_WIN32)
+    return (long) _getpid();
+#else
+    return (long) ::getpid();
+#endif
+}
+ConversationCheckpoint ck(std::vector<int32_t> ids) {
+    ConversationCheckpoint c;
+    c.ids = std::move(ids);
+    return c;
+}
+} // namespace
+
+int main() {
+    std::error_code ec;
+    const fs::path dir = fs::temp_directory_path(ec) / ("park-file-test-" + std::to_string((long long) test_pid()));
+    fs::remove_all(dir, ec);
+    fs::create_directories(dir, ec);
+    check(!ec, "temp dir");
+    std::string why;
+
+    {   // init refuses a missing directory / zero budget
+        ConversationParkFiles off;
+        check(!off.init((dir / "nope").string(), 1000, 2, 0, why) && !off.enabled(), "init refuses a missing dir");
+        check(!off.init(dir.string(), 0, 2, 0, why) && !off.enabled(), "init refuses a zero budget");
+        check(off.init(dir.string(), 300, 2, 0, why) && off.enabled(), "init accepts the dir");
+        check(off.dir() == dir.string(), "dir reported");
+    }
+    {   // slot eviction unlinks the least recently used file; budget eviction too
+        ConversationParkFiles tier;
+        check(tier.init(dir.string(), 300, 2, 0, why), "tier init");
+        const std::string p1 = write_file(dir, "a.park", 100), p2 = write_file(dir, "b.park", 100),
+                          p3 = write_file(dir, "c.park", 150), p4 = write_file(dir, "d.park", 120);
+        ParkedFile f1 = entry(100, {1, 2, 3}); f1.path = p1;
+        ParkedFile f2 = entry(100, {1, 2, 3}); f2.path = p2;
+        check(tier.put(std::move(f1), why) && tier.size() == 1 && tier.bytes() == 100, "put 1");
+        check(tier.put(std::move(f2), why) && tier.size() == 2 && tier.bytes() == 200, "put 2");
+        ParkedFile f3 = entry(150, {4, 5}); f3.path = p3;
+        check(tier.put(std::move(f3), why) && tier.size() == 2 && tier.bytes() == 250 && tier.evictions() == 1,
+              "slots evict the oldest file");
+        check(!fs::exists(p1) && fs::exists(p2) && fs::exists(p3), "eviction unlinked the evicted file");
+        ParkedFile f4 = entry(120, {6, 7}); f4.path = p4;
+        check(tier.put(std::move(f4), why) && tier.bytes() == 270 && tier.evictions() == 2, "budget evicts the oldest");
+        check(!fs::exists(p2) && fs::exists(p3) && fs::exists(p4), "budget eviction unlinked its file");
+        // take/erase: a get is a copy, an erase with unlink ends the file
+        ParkedFile got;
+        check(tier.get(0, got) && got.path == p3 && fs::exists(p3), "get copies the entry, keeps the file");
+        check(tier.erase(0, true) && !fs::exists(p3) && tier.bytes() == 120 && tier.size() == 1, "erase unlinks");
+        check(tier.erase(99, false) == false, "erase out of range");
+        // clear unlinks everything
+        check(tier.clear() == 1 && !fs::exists(p4) && tier.size() == 0 && tier.bytes() == 0, "clear unlinks all");
+    }
+    {   // matching: live prefix, deepest-checkpoint prefix, cvec; holds()
+        ConversationParkFiles tier;
+        check(tier.init(dir.string(), 1 << 20, 4, 0, why), "match tier init");
+        const std::string p5 = write_file(dir, "e.park", 10);
+        ParkedFile e5 = entry(10, {10, 11, 12, 13}, {ck({10, 11})});
+        e5.path = p5;
+        check(tier.put(std::move(e5), why), "put match entry");
+        const std::vector<int32_t> prompt = {10, 11, 12, 13, 14, 15};
+        auto m = tier.best(prompt, {}, false);
+        check(m.index == 0 && m.tokens == 4 && m.live, "best matches the live prefix");
+        auto shorter = tier.best(std::vector<int32_t>{10, 11, 99}, {}, false);
+        check(shorter.tokens == 2 && !shorter.live, "best falls back to the deepest checkpoint prefix");
+        auto cvec_miss = tier.best(prompt, {}, true);
+        check(cvec_miss.tokens == 0, "cvec mismatch does not match");
+        auto equal = tier.best(std::vector<int32_t>{10, 11, 12, 13}, {}, false);
+        check(equal.tokens == 2 && !equal.live, "an equal-length prompt matches only the shorter checkpoint (cache rule)");
+        // a chain sibling that the file does NOT carry state for is metadata only: it must never be chosen
+        ParkedFile e6 = entry(10, {20, 21, 22, 23});
+        e6.path = write_file(dir, "f.park", 10);
+        e6.saved_tokens = 0;                       // the writer saved no checkpoint (live state only)
+        e6.checkpoints.push_back(ck({20, 21, 22}));   // metadata-only chain sibling at 3 tokens
+        check(tier.put(std::move(e6), why), "put a chain-sibling entry");
+        check(tier.best(std::vector<int32_t>{20, 21, 22, 99}, {}, false).tokens == 0,
+              "a chain sibling the file does not carry is metadata only (not offered)");
+        tier.erase(1, true);
+        // the checkpoint the file DOES carry is offered (rewindable), and a live prefix still is
+        ParkedFile e7 = entry(10, {40, 41, 42, 43}, {ck({40, 41, 42})});
+        e7.path = write_file(dir, "g.park", 10);
+        check(tier.put(std::move(e7), why), "put a saved-checkpoint entry");
+        check(tier.best(std::vector<int32_t>{40, 41, 42, 99}, {}, false).tokens == 3,
+              "the saved checkpoint is offered for a prompt that diverges after it");
+        tier.erase(2, true);
+        check(tier.holds(std::vector<int32_t>{10, 11}, {}, false), "holds: a shorter state is covered");
+        check(!tier.holds(std::vector<int32_t>{10, 11, 12, 13, 14}, {}, false), "holds: a longer state is not");
+        // admit: budget/free-space
+        check(tier.admit(1000, why), "admit within the tier");
+        check(!tier.admit((1 << 20) + 1, why), "admit over the tier budget");
+        check(!tier.admit(0, why), "admit zero bytes");
+    }
+    {   // the free-space reserve is a write-time gate: init succeeds, admit() refuses
+        ConversationParkFiles tier;
+        check(tier.init(dir.string(), 1000, 2, ~uint64_t(0) / 2, why) && tier.enabled(),
+              "init allows a reserve larger than today's free space");
+        check(!tier.admit(1000, why), "admit refuses when the reserve cannot be kept");
+    }
+    fs::remove_all(dir, ec);
+    std::printf("conversation_park_file_test: %d checks passed\n", checks);
+    return 0;
+}
