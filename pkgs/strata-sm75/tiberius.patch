diff --git a/serve/test_wstat.py b/serve/test_wstat.py
new file mode 100644
index 0000000..62a093c
--- /dev/null
+++ b/serve/test_wstat.py
@@ -0,0 +1,69 @@
+"""Round-8b host smoke test for the WSTAT telemetry plumbing (no GPU, no model): the engine's per-request counters
+must survive the DONE parse (which replaces the request's figures), never leak into the next request, and reach both
+/metrics forms.  Run with pytest or `python3 serve/test_wstat.py`."""
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from serve import prometheus, server  # noqa: E402
+
+WSTAT = ("WSTAT rot=17 borrow=123456789 windows=10 rows=60 acc=40 sbw=2 sbr=3 pm=34000.0 "
+         "wsz3=4 wac3=12 ph2=120.5 ph0=55.0 phtok=50121")
+DONE = "DONE 3 18 100.0 50.0 stop 4 6 0 0 0 0 0 0.0 18 0 chunk=18 experts_streamed=0"
+
+
+def _engine():
+    e = object.__new__(server.StrataEngine)          # no process: the parsers only touch the figures
+    e.__dict__["_last"] = {}
+    e.__dict__["_last_wstat"] = None
+    return e
+
+
+def test_wstat_survives_done():
+    e = _engine()
+    server.StrataEngine._parse_wstat(e, WSTAT)
+    assert e.__dict__["_last_wstat"]["rot"] == 17, "the WSTAT line is stashed until DONE"
+    server.StrataEngine._parse_done(e, DONE)
+    assert e.last["wstat"]["rot"] == 17, "DONE must attach the stashed WSTAT to the request's figures"
+    assert e.last["wstat"]["sbw"] == 2 and e.last["wstat"]["phtok"] == 50121
+    assert e.__dict__["_last_wstat"] is None, "the stash is consumed by its own DONE"
+
+
+def test_no_wstat_does_not_inherit():
+    e = _engine()
+    server.StrataEngine._parse_wstat(e, WSTAT)
+    server.StrataEngine._parse_done(e, DONE)
+    server.StrataEngine._parse_done(e, DONE)                 # a next request that printed no WSTAT
+    assert "wstat" not in e.last, "a request must never inherit the previous one's counters"
+
+
+def test_aggregation_and_prometheus_render():
+    m = {"engine": {"model": "m", "max_context": 262144}, "live": {}, "hardware": {}, "requests": [],
+         "totals": {"requests": 1, "prompt_tokens": 5, "output_tokens": 2, "reused": 0, "drafts_offered": 0,
+                    "drafts_accepted": 0, "wstat_rot": 17, "wstat_borrow": 123456789, "wstat_windows": 10,
+                    "wstat_rows": 60, "wstat_acc": 40, "wstat_sbw": 2, "wstat_sbr": 3, "wstat_pm": 34000.0,
+                    "wstat_ph2": 120.5}}
+    lat = prometheus.Latencies()
+    lat.observe_verify(6, 1)
+    text = prometheus.render(m, lat.snapshot())
+    for family in ("strata:rotations_total", "strata:prompt_borrow_bytes_total", "strata:verify_windows_total",
+                   "strata:verify_rows_total", "strata:verify_rows_accepted_total", "strata:stop_bound_windows_total",
+                   "strata:stop_bound_rows_total", "strata:prefill_seconds_total", "strata:prefill_phase_seconds_total",
+                   "strata:verify_window_tokens"):
+        assert family in text, family
+    legacy = server.Service._prometheus_wstat_hist(lat.snapshot(), m["totals"])
+    assert "strata:verify_window_tokens_count 1" in legacy and 'phase="gdn"' in legacy
+
+
+def test_backward_compatible_without_wstat():
+    e = _engine()
+    server.StrataEngine._parse_done(e, DONE)
+    assert "wstat" not in e.last and e.last["generated"] == 3, "an engine without WSTAT lines is unchanged"
+
+
+if __name__ == "__main__":
+    for name, fn in sorted(globals().items()):
+        if name.startswith("test_") and callable(fn):
+            fn()
+            print("ok", name)
