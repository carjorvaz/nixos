+uint64_t stream_meta_peak(const SessionStreamMeta& meta) {
+    uint64_t n = 2u << 20;        // the small vectors/directories + the transient pass-2 ids/images
+    n = sat_add(n, 2 * kBlock);   // FileSource's read block + the streamed restore's staging block
+    auto add_state = [&](const std::array<uint64_t, 5>& b) {
+        for (uint64_t v : b) n = sat_add(n, v);
+        n = sat_add(n, 5 * 8);
+    };
+    add_state(meta.live_state_bytes);
+    for (const auto& b : meta.checkpoint_state_bytes) add_state(b);
+    n = sat_add(n, sat_add(8, sat_mul((uint64_t) meta.image.live.ids.size(), 4)));
+    n = sat_add(n, sat_add(8, sat_mul((uint64_t) meta.image.live.imgs.size(), 16)));
+    for (const auto& c : meta.image.checkpoints) {
+        n = sat_add(n, sat_add(8, sat_mul((uint64_t) c.ids.size(), 4)));
+        n = sat_add(n, sat_add(8, sat_mul((uint64_t) c.imgs.size(), 16)));
+        n = sat_add(n, 8);
+    }
+    n = sat_add(n, 8);
+    for (size_t layer = 0; layer < meta.kv_part_bytes.size(); ++layer) {
+        n = sat_add(n, 7 * 8);    // the K/V header: only the five part sizes are per part (the bytes themselves stream)
+        n = sat_add(n, 5 * 8);
+    }
+    return n;
+}
