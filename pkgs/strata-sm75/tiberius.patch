+// ============================ THE ADAPTIVE REFILL'S HOST COPIES ============================
+//
+// The refill admits a swap by copying the routing-missing expert's blob into the VRAM slot it evicts:
+// ~24 blobs of ~2 MB per adaptive round (96 swaps), straight out of the expert pack.  The pack is an ordinary
+// mapping of `experts.bin`, so the copy engine cannot read it: the driver stages every blob through its own
+// bounce buffer ON THIS THREAD.  Measured in the engine on a real 256-token decode, by source class:
+//
+//   registered (inside the sliding DAX window)   49 copies, 0.040 ms per 2 MB
+//   pageable    (everywhere else, 98% of them) 2543 copies, 0.867 ms per 2 MB   <- the whole cost
+//
+// and an isolated probe of the same mapping agrees: 0.61-0.93 ms per copy pageable, 0.215 ms from a registered
+// range of it (9.2 GB/s), with cudaHostRegister costing 0.083 ms per 2 MB span and cudaHostUnregister 0.044.
+// So the fix is NOT to copy the blob anywhere: it is to make the SOURCE registrable for the duration of its own
+// copy.  The DAX window registers whole layers because it must answer `pinned()` per blob for months at a time;
+// the refill knows exactly which blobs it is about to move, so it registers each blob's page-rounded span,
+// issues its copy, and releases the spans one batch later - after `apply_pending` has seen the batch's event,
+// i.e. only once the copy engine can no longer be reading them.  Off by default: STRATA_REFILL_PIN_SRC=1.
+bool refill_pin_src_enabled() {
+    static const bool v = std::getenv("STRATA_REFILL_PIN_SRC") != nullptr &&
+                          std::atoi(std::getenv("STRATA_REFILL_PIN_SRC")) != 0;
+    return v;
+}
+/// The host page size: `cudaHostRegister` takes page-aligned addresses only.  (Same arithmetic as
+/// `FileExpertSource`'s, which registers the DAX window's own page-rounded spans.)
+uint64_t host_page_bytes() {
+#if defined(_WIN32)
+    SYSTEM_INFO si{};
+    GetSystemInfo(&si);
+    return si.dwPageSize != 0 ? (uint64_t) si.dwPageSize : 4096u;
+#else
+    const long p = ::sysconf(_SC_PAGESIZE);
+    return p > 0 ? (uint64_t) p : 4096u;
+#endif
+}
