+/// Y[T, N] = X[T, K] . W[N, K]^T through fp16 tensor cores, converting both operands into the
+/// dequantization scratch `native()` also uses.  Returns false when the scratch cannot hold the
+/// weights plus one activation row, in which case the caller keeps the BF16 SIMT path.
+bool bf16_via_f16(Gemm& gm, const uint16_t* X, const uint16_t* W, float* Y, int64_t T, int64_t N, int64_t K,
+                  int64_t ldy, float beta) {
+    uint16_t* scratch = gm.scratch();
+    const int64_t cap = gm.scratch_elems();
+    if (scratch == nullptr || cap <= 0 || N <= 0 || K <= 0 || T < kFp16MinRows) return false;
+    const int64_t w_elems = N * K;
+    const int64_t w_rounded = (w_elems + 7) & ~(int64_t) 7;   // keep the activation 16-byte aligned
+    if (w_rounded + K > cap) return false;
+    int64_t rows = (cap - w_rounded) / K;
+    if (rows <= 0) return false;
+    if (rows > T) rows = T;
+    cudaStream_t cs = (cudaStream_t) gm.stream();
+    uint16_t* w16 = scratch;
+    uint16_t* x16 = scratch + w_rounded;
+    const bool dbg = gemm_debug_on();
+    if (dbg) {
+        const Scan sx = debug_scan(X, T * K, 1, cs);
+        const Scan sw = debug_scan(W, w_elems, 1, cs);
+        std::fprintf(stderr,
+                     "prefill gemm fp16: T=%lld N=%lld K=%lld ldy=%lld rows=%lld | X max=%g nf=%lld big@%lld | W max=%g "
+                     "nf=%lld big@%lld\n",
+                     (long long) T, (long long) N, (long long) K, (long long) ldy, (long long) rows,
+                     (double) sx.max_abs, sx.nonfinite, sx.first_big, (double) sw.max_abs, sw.nonfinite, sw.first_big);
+    }
+    bf16_to_f16(W, w16, w_elems, cs);
+    for (int64_t r0 = 0; r0 < T; r0 += rows) {
+        const int64_t n = (T - r0 < rows) ? (T - r0) : rows;
+        bf16_to_f16(X + r0 * K, x16, n * K, cs);
+        // Every tile writes its own Y rows, so the caller's beta applies to each of them: `beta` is a
+        // per-row scale (0.0 = overwrite), never an accumulate-into-the-previous-tile.
+        gm.f16(x16, w16, Y + r0 * ldy, n, N, K, ldy, beta);
+        if (dbg) {
+            const Scan sy = debug_scan_f32(Y + r0 * ldy, n * ldy, cs);
+            std::fprintf(stderr, "prefill gemm fp16:   Y rows[%lld..%lld) max=%g nonfinite=%lld\n", (long long) r0,
+                         (long long) (r0 + n), (double) sy.max_abs, sy.nonfinite);
+        }
+    }
+    return true;
+}
