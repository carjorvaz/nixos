# tiberius: STRATA_NO_WEB=1 turns the bundled web app off and leaves the API untouched.
#
# serve/server.py's GET router 404s the app's pages, assets, font and /settings when the
# variable is set, and the POST/other-verb router 404s /settings too (so the sidecar that
# would be written beside the read-only store config is never reached).  Upstream added
# /tool-media/ to the same router in 0.2.5, so the 404 block sits above it and returns.
#
# Regenerated against 870aedd9 (v0.2.8).
diff --git a/serve/server.py b/serve/server.py
index 5614dbf..920b1b2 100644
--- a/serve/server.py
+++ b/serve/server.py
@@ -6830,6 +6830,10 @@ def make_handler(svc: Service):
 
         def do_GET(self):
             path = self.path.split("?")[0].rstrip("/")
+            if web_disabled() and (path == "" or path == "/api-monitor" or path == "/settings" or
+                                   path.startswith(("/web/", "/fonts/"))):
+                self._json(404, {"error": {"message": "not found"}})
+                return
             if path.startswith("/tool-media/"):
                 if not self._authorized():
                     return
@@ -7221,6 +7225,9 @@ def make_handler(svc: Service):
                 return
             path = self.path.split("?")[0].rstrip("/")   # issue #55: Claude Code posts /v1/messages?beta=true
             path = V1_V1_ALIASES.get(path, path)         # an Anthropic client given ".../v1" as its base posts /v1/v1/messages
+            if web_disabled() and path == "/settings":
+                self._json(404, {"error": {"message": "not found"}})
+                return
             if path.startswith("/v1/") and self._foreign_page():
                 return
             if path == "/settings":
@@ -8104,6 +8111,11 @@ def _name_in(name: str, names) -> bool:
     return name in names or any(n.startswith(".") and (name.endswith(n) or name == n[1:]) for n in names)
 
 
+def web_disabled() -> bool:
+    """The bundled web app (its pages, assets and /settings) is off when STRATA_NO_WEB is set; the API is unaffected."""
+    return os.environ.get("STRATA_NO_WEB", "") not in ("", "0")
+
+
 def allowed_hosts_of(value, env: str = "") -> list[str]:
     """The config's allowed_hosts (a name or a list) plus $STRATA_ALLOWED_HOSTS (comma-separated): host names, "*" or
     ".example.com" (it and every name below it).  A scheme, port or path is dropped ("https://a.example.com:8443/"
