-/// 2-bit unpack via VPMULTISHIFTQB.
+/// 2-bit unpack, VBMI-free: the fixed shift pattern 0x0E0C0A0806040200 expanded with F/BW shifts.
 ///
-/// ARGUMENT ORDER IS (control, data) AND WAS DETERMINED EMPIRICALLY (`bench/micro/probe_multishift.cpp`).
-/// The Intel guide states (a=data, b=control); using that produced 43 of 64 wrong codes.  `plan.md`'s sketch
-/// passes the shift pattern first, which is correct - so a "fix" that swapped it to match the guide was the
-/// bug, not the fix.  Within each 64-bit lane, output byte i is `(u16 >> 2i) & 0xFF`, so AND 3 yields the
-/// eight 2-bit codes in order.
+/// Within each 64-bit lane, output byte i is `(u16 >> 2i) & 3`, so the eight 2-bit codes come out in order.
+/// With a CONSTANT shift pattern that is exactly what VPMULTISHIFTQB produced, so eight masked 16-bit shifts
+/// plus per-byte placement are bit-identical - and they keep this translation unit free of VBMI, which is what
+/// lets the package drop -mavx512vbmi from the flag list: the AVX-512 tier then runs on F/DQ/BW/VL/VNNI CPUs
+/// that lack it (Cascade Lake; upstream's run-time cpu_vnni_ok chooses the tier, STRATA_VNNI_TIER=1 on this
+/// box).  The old VPMULTISHIFTQB form took (control, data) - the Intel guide states the opposite, and
+/// following the guide produced 43 of 64 wrong codes - but no intrinsic remains here to get the order wrong.
 ///
 /// The result is the 32 codes of ONE ACTIVATION CHUNK (4 qword lanes), which is the unit the Q8_1 scale is
 /// defined on - not the 64-weight block.
 inline __m256i unpack_q2_0(const uint8_t* codes) {
     const __m128i packed = _mm_loadl_epi64((const __m128i*) codes);   // 8 bytes -> 4 u16 in the low half
-    const __m256i lanes = _mm256_cvtepu16_epi64(packed);              // 4 qwords, 8 codes each
-    const __m256i ctrl = _mm256_set1_epi64x((long long) 0x0E0C0A0806040200ULL);
-    return _mm256_and_si256(_mm256_multishift_epi64_epi8(ctrl, lanes), _mm256_set1_epi8(3));
+    const __m256i q = _mm256_cvtepu16_epi64(packed);                  // 4 qwords, one u16 each (lanes 0,4,8,12)
+    // Same VBMI-free construction as unpack64_q2_0, in 256-bit lanes: VPERMW replicates each u16 into eight
+    // of the sixteen 16-bit lanes that become its code bytes, VPSRLVW shifts each lane by 2*(lane%8), VPMOVWB
+    // truncates to bytes.  Two rounds of two u16s each, joined by VINSERTI128.  Byte k = (u16 >> 2*(k%8)) & 3
+    // - the exact VPMULTISHIFTQB layout (verified against a scalar reference when written).
+    const uint16_t idx0_a[16] = {0, 0, 0, 0, 0, 0, 0, 0, 4, 4, 4, 4, 4, 4, 4, 4};
+    const uint16_t idx1_a[16] = {8, 8, 8, 8, 8, 8, 8, 8, 12, 12, 12, 12, 12, 12, 12, 12};
+    const uint16_t sh_a[16] = {0, 2, 4, 6, 8, 10, 12, 14, 0, 2, 4, 6, 8, 10, 12, 14};
+    const __m256i idx0 = _mm256_loadu_si256((const __m256i*) idx0_a);
+    const __m256i idx1 = _mm256_loadu_si256((const __m256i*) idx1_a);
+    const __m256i sh = _mm256_loadu_si256((const __m256i*) sh_a);
+    const __m256i m3 = _mm256_set1_epi16(0x0003);
+    const __m128i lo = _mm256_cvtepi16_epi8(
+        _mm256_and_si256(_mm256_srlv_epi16(_mm256_permutexvar_epi16(idx0, q), sh), m3));
+    const __m128i hi = _mm256_cvtepi16_epi8(
+        _mm256_and_si256(_mm256_srlv_epi16(_mm256_permutexvar_epi16(idx1, q), sh), m3));
+    return _mm256_inserti128_si256(_mm256_castsi128_si256(lo), hi, 1);
 }
 
