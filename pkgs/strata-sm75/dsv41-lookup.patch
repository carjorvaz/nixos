+// ---- Strata addition: zero-weight prompt lookup (--lookup) -------------------------------------------------
+// A SuffixDrafter proposes the tokens that followed the last earlier occurrence of the request's history and the pending
+// token: free (no weights, no GPU) and exact on text that quotes its context - edits, refactors, repeated blocks.  The
+// proposal is only a proposal: it goes through the same Model::verify() as the drafter's drafts, so the output stays the
+// model's own.  On ordinary chat a window reads the union of its rows' experts, and on this box (experts from Optane)
+// that costs more than the tokens it gains; DraftPolicy gates each round on expected tokens per ms and learns both
+// sides from the measured rounds, so chat falls back to plain steps while a copy does not.
+// Model::verify() takes at most kWin - 1 drafts (kWin = 16, ds4_kernels.cuh: its scratch holds 16 ids and 16 chain
+// entries), so a proposal never asks for more - nothing is silently dropped by its clamp.
+constexpr int kVerifyDrafts = 15;
+
+struct LookupOpts {
+    enum Mode { kOff = 0, kAuto = 1, kOn = 2 };
+    int mode = kAuto;     // --lookup: off; on (proposes beside a drafter too); auto (only when the DSpark drafter is absent)
+    int k = 2;            // --lookup-k: drafts a proposal offers (a window of k + 1 rows; 2 is the copy sweet spot)
+    int min_match = 3;    // --lookup-min: the shortest history match that proposes (SuffixDrafter: at least 3)
+    bool wanted(int draft_block) const { return mode == kOn || (mode == kAuto && draft_block == 0); }
+};
+
+// per request (serve) or per run (--ids, --spec-eval): the history and that unit's round policy
+struct Lookup {
+    explicit Lookup(const LookupOpts& o)
+        : opt(o), suffix(o.min_match, 32, size_t(1) << 17), policy(8, 0.10) {
+        // Round costs (ms) by window size before this box measures its own: ~180 ms a token (the measured 5.4-5.9
+        // tok/s) and a window's union of expert reads at 1.96x / 2.91x / 3.84x / 4.76x one token's bytes.  Every
+        // observed round replaces them (EMA), so these only seed the first verdicts.
+        const double ms[5] = {180.0, 353.0, 524.0, 691.0, 857.0};
+        policy.seed_costs(ms, 5, 1.0);
+    }
+    LookupOpts opt;
+    strata::spec::SuffixDrafter suffix;
+    strata::spec::DraftPolicy policy;
+};
+
