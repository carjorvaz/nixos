 using namespace ninfer::test;
 
 namespace {
+
+// Warm each route before capture. Append is idempotent at fixed positions;
+// poison output before each replay so a stale result cannot satisfy the oracle.
+template <class Launch>
+void eager_and_graph(Launch launch, void* output, std::size_t bytes) {
+    launch(nullptr);
+    cuda_synchronize();
+    cudaStream_t stream;
+    cudaGraph_t graph;
+    cudaGraphExec_t executable;
+    cuda_check(cudaStreamCreate(&stream), "create graph test stream");
+    cuda_check(cudaStreamBeginCapture(stream, cudaStreamCaptureModeGlobal), "begin capture");
+    launch(stream);
+    cuda_check(cudaStreamEndCapture(stream, &graph), "end capture");
+    cuda_check(cudaGraphInstantiate(&executable, graph, nullptr, nullptr, 0), "instantiate graph");
+    for (int replay = 0; replay < 2; ++replay) {
+        cuda_check(cudaMemsetAsync(output, 0xff, bytes, stream), "poison graph output");
+        cuda_check(cudaGraphLaunch(executable, stream), "replay graph");
+        cuda_synchronize(stream);
+    }
+    cuda_check(cudaGraphExecDestroy(executable), "destroy graph executable");
+    cuda_check(cudaGraphDestroy(graph), "destroy graph");
+    cuda_check(cudaStreamDestroy(stream), "destroy graph test stream");
+}
 
